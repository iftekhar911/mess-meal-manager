# Node Environment
NODE_ENV=development
PORT=4000
APP_TIMEZONE=Asia/Dhaka

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mess_meal_manager

# Security & Authentication
JWT_ACCESS_SECRET=replace_with_super_secret_jwt_access_key_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_super_secret_jwt_refresh_key_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_cookie_signing_secret_minimum_32_characters

# Throttler / Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Client App URL (CORS allowlist)
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
