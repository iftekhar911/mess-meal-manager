{
  "name": "mess-meal-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first shared mess meal accounting application for Bangladesh",
  "scripts": {
    "dev:api": "pnpm --filter @mess/api start:dev",
    "dev:web": "pnpm --filter @mess/web dev",
    "dev": "pnpm --parallel dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.21.0"
}
